{
  "name": "luminous",
  "version": "2.0.0",
  "description": "A high-performance home for the music you already own",
  "author": "Eric James Soltys <ericjamessoltys@outlook.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run sync-docs && svelte-kit sync && vite dev",
    "build": "bun run sync-docs && svelte-kit sync && vite build",
    "sync-docs": "bun run scripts/sync-docs.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "install:git-hooks": "git config core.hooksPath .githooks",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo && bun run knip",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "knip": "knip",
    "tauri": "NO_STRIP=true tauri",
    "icon": "tauri icon app-icon.svg && bun run scripts/generate-msix-assets.ts",
    "generate:msix-assets": "bun run scripts/generate-msix-assets.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:perf": "vitest run --config vite.perf.config.js",
    "take-screenshots": "bunx tsx scripts/take-screenshots.ts",
    "release": "bun run scripts/release.ts",
    "bump-version": "bun run scripts/bump-version.ts",
    "tauri:windows:build": "tauri-windows-bundle build",
    "measure-memory": "bun run scripts/measure-memory.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "phosphor-svelte": "^3.1.0",
    "simple-icons": "^16.28.0",
    "svelte-virtual-list-ts": "^0.0.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.28",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "image-js": "^1.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "music-metadata": "^11.15.0",
    "playwright": "^1.62.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.5",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "cookie": "^0.7.0",
    "nanoid": "^3.3.18"
  },
  "resolutions": {
    "postcss": "^8.5.18",
    "cookie": "^0.7.0",
    "nanoid": "^3.3.18"
  }
}
