{
  "name": "luminous",
  "version": "2.6.0",
  "description": "A high-performance home for the music you already own",
  "author": "Eric James Soltys <ericjamessoltys@outlook.com>",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun run sync-docs && svelte-kit sync && vite dev",
    "build": "bun run sync-docs && svelte-kit sync && vite build",
    "sync-docs": "bun run scripts/sync-docs.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "install:git-hooks": "git config core.hooksPath .githooks",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --fail-on-warnings && bun run knip && bun run lint:css-vars",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "check:tauri-versions": "bun run scripts/check-tauri-versions.ts",
    "knip": "knip",
    "lint:css-vars": "bun run scripts/lint-css-vars.ts",
    "tauri": "bun scripts/tauri.ts",
    "icon": "tauri icon app-icon.png && bun run scripts/generate-msix-assets.ts",
    "generate:msix-assets": "bun run scripts/generate-msix-assets.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:ast": "bunx @ast-grep/cli scan && bunx @ast-grep/cli test",
    "test:perf": "vitest run --config vite.perf.config.js",
    "take-screenshots": "bunx tsx scripts/take-screenshots.ts",
    "take-dynamic-screenshots": "bunx tsx scripts/capture-dynamic-themes.ts",
    "style-diff": "bunx tsx scripts/style-diff.ts",
    "test:e2e:windows": "tauri build --debug --no-bundle && bunx tsx e2e/run-smoke.ts",
    "release": "bun run scripts/release.ts",
    "bump-version": "bun run scripts/bump-version.ts",
    "tauri:windows:build": "tauri-windows-bundle build --runner bun",
    "measure-memory": "bun run scripts/measure-memory.ts",
    "perf:memory": "bun run scripts/perf-memory-scenarios.ts",
    "perf:chart": "python scripts/perf-chart.py",
    "monitor-cdp": "bun run scripts/monitor-cdp.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "phosphor-svelte": "^3.1.0",
    "simple-icons": "^16.34.0",
    "svelte-virtual-list-ts": "^0.0.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.3",
    "@choochmeque/tauri-windows-bundle": "^0.2.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "image-js": "^1.7.1",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "music-metadata": "^11.16.1",
    "playwright": "^1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "nanoid": "^3.3.18"
  },
  "resolutions": {
    "postcss": "^8.5.18",
    "nanoid": "^3.3.18"
  }
}
