.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
# Local Claude Code state (session plans, CLAUDE.md, etc.) stays untracked,
# except the SessionStart hook below, which is committed so remote sessions
# pick it up (see .claude/hooks/session-start.sh).
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
!.claude/skills/
!.claude/skills/**
/.worktrees

# Personal override for the Tauri IPC mock config (scripts/mock-config.json is tracked directly)
scripts/mock-config.local.json

# Local Cargo configuration
.cargo/
*.cargo/config.toml

# Cargo build output
/target/
/src-tauri/target/

# Scratch file for Claude's per-task walkthrough summaries (see .claude/CLAUDE.md) —
# always local-only, never meant to land in a commit.
/WALKTHROUGH.md
/walkthrough.md

# Synced from docs/user-guide/ by `bun run sync-docs` (see scripts/sync-docs.ts)
/static/luminous-user-guide-EN.html
/static/luminous-user-guide-FR.html
/static/support.js
/static/image-slot.js
/static/luminous-mark.svg
/static/expose-700.woff2
/static/screenshots/
/static/assets/

