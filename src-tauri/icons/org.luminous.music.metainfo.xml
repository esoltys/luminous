  <name>Luminous Music Player</name>
  <summary>A high-performance home for the music you already own</summary>
  <description>
    <p>
      Luminous is a fast, local-first player for your own audio library — no streaming, no
      subscriptions, no cloud. Just your files, indexed, searchable, and beautifully played.
    </p>
  </description>
  <developer_name>Eric James Soltys</developer_name>
  <launchable type="desktop-id">org.luminous.music.desktop</launchable>
