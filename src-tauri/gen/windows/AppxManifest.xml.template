<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

  <Identity
    Name="{{PACKAGE_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
      MinVersion="{{MIN_VERSION}}"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="{{EXECUTABLE}}"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="{{DESCRIPTION}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="mp3audio">
            <uap:DisplayName>MP3 Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-mp3.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.mp3</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="flacaudio">
            <uap:DisplayName>FLAC Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-flac.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.flac</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="oggaudio">
            <uap:DisplayName>Ogg Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-ogg.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.opus</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="m4aaudio">
            <uap:DisplayName>M4A Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-m4a.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.m4a</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="alacaudio">
            <uap:DisplayName>ALAC Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-alac.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.alac</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="aacaudio">
            <uap:DisplayName>AAC Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-aac.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.aac</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="wavaudio">
            <uap:DisplayName>WAV Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-wav.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.wav</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="aiffaudio">
            <uap:DisplayName>AIFF Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-generic.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.aiff</uap:FileType>
              <uap:FileType>.aif</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="wavpackaudio">
