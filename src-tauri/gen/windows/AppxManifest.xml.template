          <uap:FileTypeAssociation Name="trueaudio">
            <uap:DisplayName>True Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-generic.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.tta</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="dsdstreamfile">
            <uap:DisplayName>DSD Stream File</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-generic.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.dsf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="dsdiffaudio">
            <uap:DisplayName>DSDIFF Audio</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-generic.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.dff</uap:FileType>
