            <uap:SupportedFileTypes>
              <uap:FileType>.m4b</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="m3uplaylist">
            <uap:DisplayName>M3U Playlist</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-m3u.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.m3u</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="m3u8playlist">
            <uap:DisplayName>M3U8 Playlist</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-m3u8.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.m3u8</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="plsplaylist">
            <uap:DisplayName>PLS Playlist</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-generic.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.pls</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="xspfplaylist">
            <uap:DisplayName>XSPF Playlist</uap:DisplayName>
            <uap:Logo>icons\filetypes\luminous-file-generic.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.xspf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
{{CAPABILITIES}}
  </Capabilities>
</Package>
