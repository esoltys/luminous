            <uap:Logo>icons\filetypes\luminous-file-generic.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.wv</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
