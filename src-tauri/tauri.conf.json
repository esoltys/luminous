{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luminous",
  "version": "0.96.0",
  "identifier": "org.luminous.music",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Luminous",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3", "flac", "ogg", "opus", "m4a", "aac", "alac", "wav",
          "aiff", "aif", "wv", "mpc", "ape", "tta", "dsf", "dff", "asf", "wma", "m4b"
        ],
        "name": "Audio File",
        "description": "Music file supported by Luminous",
        "role": "Viewer"
      },
      {
        "ext": ["m3u", "m3u8", "pls", "xspf"],
        "name": "Playlist File",
        "description": "Playlist supported by Luminous",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRDY5QzUxMjJGNjQ5Q0IKUldTWU0vQytnVG1tTXlWVnpPZm5zNkdFTHdCSU9ldGlDNG9ZUXZCVHR0dzVzK3FRTHJ0Vw==",
      "endpoints": [
        "https://github.com/esoltys/luminous/releases/latest/download/latest.json"
      ]
    }
  }
}
