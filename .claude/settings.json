{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "extraKnownMarketplaces": {
    "esoltys-skills": {
      "source": {
        "source": "github",
        "repo": "esoltys/esoltys-skills"
      }
    }
  },
  "enabledPlugins": {
    "esoltys-skills@esoltys-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.sh",
            "timeout": 200
          }
        ]
      }
    ]
  }
}
